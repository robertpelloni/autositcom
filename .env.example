# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Gemini API key from https://aistudio.google.com — required for the
# distiller and scriptwriter stages. Must be a Gemini key, not an OAuth token.
GEMINI_API_KEY=
# Optional / future stages:
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
YOUTUBE_CLIENT_SECRET=
TIKTOK_SESSION_TOKEN=
